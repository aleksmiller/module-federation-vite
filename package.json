{
  "name": "module-federation-vite",
  "version": "1.0.0",
  "description": "Reference template for a React microfrontend architecture built on Vite and Module Federation",
  "private": true,
  "license": "MIT",
  "keywords": [
    "microfrontend",
    "module-federation",
    "vite",
    "react"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "shared",
    "host",
    "mfe1"
  ],
  "scripts": {
    "dev": "concurrently -n mfe1,host -c magenta,green \"npm:dev:mfe1\" \"npm:dev:host\"",
    "dev:host": "npm run dev --workspace=host",
    "dev:mfe1": "npm run dev --workspace=mfe1",
    "build": "npm run build --workspace=mfe1 && npm run build --workspace=host",
    "preview": "concurrently -n mfe1,host -c magenta,green \"npm:preview:mfe1\" \"npm:preview:host\"",
    "preview:host": "npm run preview --workspace=host",
    "preview:mfe1": "npm run preview --workspace=mfe1",
    "clean": "npm run clean --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@module-federation/vite": "^1.8.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6"
  }
}
